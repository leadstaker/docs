{
    "$schema": "https://mintlify.com/docs.json",
    "theme": "mint",
    "name": "Leadstaker",
    "colors": {
        "primary": "#FC0168",
        "light": "#FC0168",
        "dark": "#FC0168"
    },
    "favicon": "/favicon.svg",
    "fonts": {
        "family": "Mozilla Text"
    },
    "navigation": {
        "tabs": [
            {
                "tab": "Documentation",
                "pages": [
                    "index",
                    "quickstart"
                ]
            },
            {
                "tab": "API Reference",
                "icon": "brackets-curly",
                "groups": [
                    {
                        "group": "Começar",
                        "pages": [
                            "api-reference/authentication",
                            "api-reference/listing",
                            "api-reference/errors"
                        ]
                    },
                    {
                        "group": "Endpoints",
                        "openapi": "api-reference/openapi.json"
                    }
                ]
            }
        ],
        "global": {
            "anchors": [
                {
                    "anchor": "Documentation",
                    "href": "/",
                    "icon": "book-open-cover"
                }
            ]
        }
    },
    "logo": {
        "light": "/logo/light.svg",
        "dark": "/logo/dark.svg"
    },
    "navbar": {
        "links": [
            {
                "label": "Home",
                "href": "https://leadstaker.com"
            },
            {
                "label": "Sign In",
                "href": "https://app.leadstaker.com"
            }
        ],
        "primary": {
            "type": "button",
            "label": "Get Started",
            "href": "https://app.leadstaker.com"
        }
    },
    "contextual": {
        "options": [
            "copy",
            "view",
            "chatgpt",
            "claude",
            "perplexity",
            "mcp",
            "cursor",
            "vscode"
        ]
    },
    "footer": {
        "socials": {
            "instagram": "https://www.instagram.com/leadstaker/",
            "website": "https://leadstaker.com"
        }
    }
}